# Copier ce fichier en `.env` (jamais commité) puis renseigner les valeurs.
# Sans ces deux variables, l'application démarre en MODE DÉMONSTRATION (données fictives).

# URL du projet Supabase (Tableau de bord Supabase > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIQUE uniquement (« publishable key », anciennement « anon key »).
# Elle est conçue pour être embarquée dans l'application : la sécurité repose sur les politiques RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ⚠️ NE JAMAIS mettre ici la clé « secret » / « service_role » :
# toute variable préfixée EXPO_PUBLIC_ est lisible dans l'application installée.
